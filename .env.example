# ==========================================================================
# 《藏经坞》环境变量样例
# 用法：复制为仓库根目录的 .env（开发）或 /etc/cangjingwu/cangjingwu.env（生产）
#       cp .env.example .env
# 生产环境该文件权限必须是 600，属主 cangjingwu：
#       chown cangjingwu:cangjingwu /etc/cangjingwu/cangjingwu.env && chmod 600 /etc/cangjingwu/cangjingwu.env
#
# 新站相对旧站 26.1.1 删掉的配置组：ADMIN_*（改叫 OWNER_*）、WORKER_API_KEY 与
# TASK_*（分析机）、AI_*（问道台）、PET_*（宠物决策）、DSH_*（内核 sidecar）。
# ==========================================================================

# ---------- 基础 ----------
# development | production （生产环境会开启更严格的日志与错误处理）
NODE_ENV=development
# 监听端口；生产建议只监听回环，由 Nginx 反代：HOST=127.0.0.1
HOST=0.0.0.0
PORT=8080
# 对外访问地址（用于日志与分享链接展示）
PUBLIC_BASE_URL=http://localhost:8080
# 站点显示名
SITE_NAME=藏经坞

# ---------- 目录（生产：/var/lib/cangjingwu/...） ----------
# 数据库目录，默认 <apps/server>/data
# DATA_DIR=/var/lib/cangjingwu/data
# 文件存储目录，默认 <apps/server>/storage
# STORAGE_DIR=/var/lib/cangjingwu/storage
# 前端构建产物目录，默认 <仓库根>/apps/web/dist（生产由后端同源托管）
# WEB_DIST=/opt/cangjingwu/apps/web/dist

# ---------- 坞主与 JWT ----------
# 坞主是唯一的内容管理者：建文稿、建文件夹、审投稿、发邀请码。
# 身份判定 = **登录用户名等于 OWNER_USERNAME**，数据库里没有角色列。
# 首次启动会用下面两项创建坞主；之后改密码请用 POST /api/auth/password
# 也可直接填 OWNER_PASSWORD_HASH（bcrypt 哈希）来避免明文落盘
OWNER_USERNAME=keeper
OWNER_PASSWORD=change-me-please-123
# OWNER_PASSWORD_HASH=
# JWT 密钥：至少 32 字符随机串。生成：openssl rand -base64 48
JWT_SECRET=please-generate-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h

# ---------- 上传限制 ----------
# 单文件上限（字节）。512MB = 536870912。带宽有限时先小后大
UPLOAD_MAX_BYTES=536870912
# 单次请求最多文件数
UPLOAD_MAX_FILES=20

# ---------- 收录审核（先审后公开） ----------
# 1 = 任何登录用户都能投稿，但投稿进待审区，坞主放行后才对外可见
# 0 = 投稿即公开（先公开后看）
REVIEW_REQUIRED=1

# ---------- 外部程序（可选，缺失则优雅降级） ----------
# Linux 由 apt 安装后在 PATH 中，无需配置；Windows 例：D:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 设为 0 可彻底关闭缩略图/时长探测
MEDIA_PROBE_ENABLED=1

# ---------- 跨域（仅开发期需要；生产同源可留空） ----------
# 逗号分隔，例如 http://localhost:5173,http://192.168.1.10:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 限流（内存计数，单实例） ----------
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_SECONDS=60

# ---------- 定时清理 ----------
JANITOR_INTERVAL_SECONDS=30
# 临时目录文件保留时长（秒）
TMP_RETENTION_SECONDS=86400
