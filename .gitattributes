# 换行符策略
# 仓库内统一存 LF；Windows 检出也不转 CRLF，避免部署到 Linux 时 .sh 出现 ^M。
* text=auto eol=lf

# shell 脚本必须是 LF，否则在 Linux 上会报 "bad interpreter"
*.sh    text eol=lf
*.service text eol=lf

# 明确标记二进制，避免被当文本做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.zip   binary
*.db    binary
